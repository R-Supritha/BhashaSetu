# ────────────────────────────────────────────────────────────────
# BhashaSetu — Environment Variables
# Copy this file to .env and adjust values for your machine.
# ────────────────────────────────────────────────────────────────

# App mode: "demo" = canned responses, no external services needed
#            "real" = call actual ASR / translation / LLM services
APP_MODE=demo

# ── Flask ──────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-me-to-a-random-string
FLASK_DEBUG=false
FLASK_PORT=5000

# ── Ollama (local LLM) ────────────────────────────────────────
# Used whenever the daemon is reachable (APP_MODE=real preferred).
# The app never crashes if Ollama is down; it falls back and labels the mode.
# OLLAMA_MODEL must be an exact tag that is actually installed (`ollama list`).
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT=45

# ── Vosk ASR model path (optional) ────────────────────────────
# Default: ./models/vosk-model-small-hi-0.22
# Download from https://alphacephei.com/vosk/models and extract into models/
# VOSK_ASR_MODEL_DIR=./models/vosk-model-small-hi-0.22

# ── Optional local model paths ─────────────────────────────────
# Leave empty unless you have actually installed them.
# IndicTrans2 does NOT support Santali (sat) — do not point this at hi<->sat.
INDICTRANS2_PATH=
INDICLID_PATH=
INDICXLIT_PATH=
INDICCONFORMER_PATH=

# ── Bhashini NMT credentials (optional) ───────────────────────
# For genuine Hindi<->Santali NMT via the DHRUVA/ULCA pipeline API.
# When all three are present and APP_MODE=real, /api/translate attempts
# REAL Bhashini NMT first and falls back to the classroom phrase/glossary table.
# Register at https://dashboard.bhashini.co.in to obtain these.
# BHASHINI_USER_ID=
# BHASHINI_API_KEY=
# BHASHINI_PIPELINE_ID=
BHASHINI_TRANSLATION_TIMEOUT=30

# ── Bhashini ASR/TTS endpoints (optional) ─────────────────────
# Only if the deployed pipeline actually lists sat/Ol Chiki — otherwise leave blank.
BHASHINI_ASR_URL=
BHASHINI_TTS_URL=

# ── ChromaDB (only when APP_MODE=real) ────────────────────────
CHROMA_PERSIST_DIR=./data/chroma

# ── JSON file-store location (no MongoDB) ──────────────────────
DATA_DIR=./data
